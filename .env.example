# --- Supabase (Settings > API Keys). Nouvelles clés, pas les clés legacy anon / service_role.
NEXT_PUBLIC_SUPABASE_URL=https://spuacvknjmbhirfxfptt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète (sb_secret_...) : webhook Stripe et remboursement des images ratées. Type "Secret" dans Vercel.
SUPABASE_SECRET_KEY=

# --- Thèmes : signe les liens de téléchargement des zips (32 caractères aléatoires minimum).
THEME_DOWNLOAD_SECRET=

# --- Génération d'images (facultatif : sans cette clé ou sans SUPABASE_SECRET_KEY, l'outil répond que les images ne sont pas activées).
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_BASE_URL=

# --- Stripe (facultatif : sans clé, la page Abonnement indique que le paiement n'est pas activé).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
