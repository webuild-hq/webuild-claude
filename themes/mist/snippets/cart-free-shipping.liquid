{% comment %}
  Free shipping progress toward a threshold.

  The threshold is entered in the shop's currency and converted to cents here,
  because cart.total_price is in cents. Comparing the two directly is the usual
  source of a bar that fills at 1% of the real target.

  Accepts:
  - section: {Object} the cart footer section, for its settings (required)
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign threshold = s.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price

  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}

{%- if s.show_free_shipping and threshold > 0 and cart != empty -%}
  <div class="cart-shipping-bar">
    <p class="cart-shipping-bar__message">
      {%- if s.show_shipping_icon -%}
        <span class="svg-wrapper">
          {{- 'icon-box.svg' | inline_asset_content -}}
        </span>
      {%- endif -%}
      <span>
        {%- if remaining > 0 -%}
          {%- comment -%}
            money has to be applied to the amount before the substitution.
            Chained as `| replace: ... | money` it would instead run against the
            finished sentence, which formats to $0.00.
          {%- endcomment -%}
          {%- assign remaining_money = remaining | money -%}
          {{ s.free_shipping_text | replace: '[amount]', remaining_money }}
        {%- else -%}
          {{ s.free_shipping_reached }}
        {%- endif -%}
      </span>
    </p>

    <div
      class="cart-shipping-bar__track"
      role="progressbar"
      aria-valuenow="{{ pct }}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <span class="cart-shipping-bar__fill" style="width: {{ pct }}%;"></span>
    </div>
  </div>
{%- endif -%}
