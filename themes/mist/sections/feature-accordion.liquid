{{ 'section-feature-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings

  assign divider_paint = 'rgba(var(--color-foreground), 0.15)'
  if s.divider_color != blank
    assign divider_paint = s.divider_color
  endif
-%}

{%- style -%}
  #FeatureAccordion-{{ section.id }} {
    --fa-split-width: {{ s.split_width }}%;
    --fa-split-gap: {{ s.split_gap }}px;
    --fa-speed: {{ s.animation_speed }}ms;

    --fa-overline-size: {{ s.overline_size }}px;
    --fa-overline-spacing: {{ s.overline_spacing | divided_by: 100.0 }}em;
    --fa-overline-gap: {{ s.overline_gap }}px;
    --fa-heading-size: {{ s.heading_size | times: 0.75 | round: 0 }}px;
    --fa-heading-line-height: {{ s.heading_line_height | divided_by: 100.0 }};
    --fa-heading-spacing: {{ s.heading_spacing | divided_by: 100.0 }}em;
    --fa-body-size: {{ s.body_size }}px;
    --fa-body-gap: {{ s.body_gap }}px;

    --fa-title-size: {{ s.title_size }}px;
    --fa-title-gap: {{ s.title_gap }}px;
    --fa-row-padding-y: {{ s.row_padding_y }}px;
    --fa-icon-size: {{ s.icon_size }}px;
    --fa-answer-size: {{ s.answer_size }}px;
    --fa-answer-line-height: {{ s.answer_line_height | divided_by: 100.0 }};
    --fa-answer-padding-bottom: {{ s.answer_padding_bottom }}px;
    --fa-answer-indent: {{ s.answer_indent }}px;

    --fa-toggle-size: {{ s.toggle_size }}px;
    --fa-toggle-icon-size: {{ s.toggle_icon_size }}px;
    --fa-divider-width: {{ s.divider_width }}px;
    --fa-divider-color: {{ divider_paint }};

    {%- if s.overline_weight != 'inherit' %} --fa-overline-weight: {{ s.overline_weight }};{% endif %}
    {%- if s.heading_weight != 'inherit' %} --fa-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.title_weight != 'inherit' %} --fa-title-weight: {{ s.title_weight }};{% endif %}
    {%- if s.overline_color != blank %} --fa-overline-color: {{ s.overline_color }};{% endif %}
    {%- if s.heading_color != blank %} --fa-heading-color: {{ s.heading_color }};{% endif %}
    {%- if s.body_color != blank %} --fa-body-color: {{ s.body_color }};{% endif %}
    {%- if s.title_color != blank %} --fa-title-color: {{ s.title_color }};{% endif %}
    {%- if s.icon_color != blank %} --fa-icon-color: {{ s.icon_color }};{% endif %}
    {%- if s.answer_color != blank %} --fa-answer-color: {{ s.answer_color }};{% endif %}
    {%- if s.toggle_bg != blank %} --fa-toggle-bg: {{ s.toggle_bg }};{% endif %}
    {%- if s.toggle_bg_hover != blank %} --fa-toggle-bg-hover: {{ s.toggle_bg_hover }};{% endif %}
    {%- if s.toggle_color != blank %} --fa-toggle-color: {{ s.toggle_color }};{% endif %}
  }

  #FeatureAccordion-{{ section.id }} .feature-accordion__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #FeatureAccordion-{{ section.id }} {
      --fa-heading-size: {{ s.heading_size }}px;
    }

    #FeatureAccordion-{{ section.id }} .feature-accordion__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FeatureAccordion-{{ section.id }}"
  class="feature-accordion color-{{ s.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="feature-accordion__inner{% unless s.full_width %} page-width{% endunless %}">
    <div class="feature-accordion__layout{% if s.sticky_intro %} feature-accordion__layout--sticky{% endif %}">
      <div class="feature-accordion__intro">
        {%- if s.overline != blank -%}
          <p class="feature-accordion__overline">{{ s.overline | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="feature-accordion__heading inline-richtext">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="feature-accordion__body rte">{{ s.body }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <accordion-rows
          class="feature-accordion__list{% unless s.show_outer_dividers %} feature-accordion__list--no-outer{% endunless %}"
          data-single-open="{{ s.single_open }}"
          data-speed="{{ s.animation_speed }}"
        >
          {%- for block in section.blocks -%}
            <details
              class="feature-accordion__item"
              {% if s.open_first and forloop.first %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="feature-accordion__question">
                {%- if block.settings.icon != 'none' -%}
                  {%- assign icon_file = 'icon-' | append: block.settings.icon | append: '.svg' -%}
                  <span class="feature-accordion__icon" aria-hidden="true">
                    {{- icon_file | inline_asset_content -}}
                  </span>
                {%- endif -%}
                <h3 class="feature-accordion__title">{{ block.settings.title | escape }}</h3>
                <span class="feature-accordion__toggle" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </summary>
              <div class="feature-accordion__panel" data-accordion-panel>
                <div class="feature-accordion__answer rte">{{ block.settings.content }}</div>
              </div>
            </details>
          {%- endfor -%}
        </accordion-rows>
      {%- endif -%}
    </div>
  </div>
</div>

