{{ 'section-press-quotes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols = section.settings.columns_desktop | plus: 0
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign sep_alpha = section.settings.separator_opacity | divided_by: 100.0
  if section.settings.separator_color != blank
    assign sep_paint = section.settings.separator_color | color_modify: 'alpha', sep_alpha
  else
    assign sep_paint = 'rgba(var(--color-foreground), ' | append: sep_alpha | append: ')'
  endif
-%}

{%- style -%}
  #PressQuotes-{{ section.id }} {
    --pq-columns: {{ section.settings.columns_desktop }};
    --pq-columns-mobile: {{ section.settings.columns_mobile }};
    --pq-column-gap: {{ section.settings.column_gap }}rem;
    --pq-row-gap: {{ section.settings.row_gap }}rem;
    --pq-logo-height: {{ section.settings.logo_height }}px;
    --pq-logo-gap: {{ section.settings.logo_gap }}rem;
    --pq-quote-size: {{ section.settings.quote_size }}px;
    --pq-quote-line-height: {{ section.settings.quote_line_height | divided_by: 100.0 }};
    {%- if section.settings.quote_weight != 'inherit' %}--pq-quote-weight: {{ section.settings.quote_weight }};{% endif %}
    {%- if section.settings.quote_color != blank %}--pq-quote-color: {{ section.settings.quote_color }};{% endif %}
    {%- if section.settings.logo_opacity < 100 %}--pq-logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};{% endif %}
  }

  #PressQuotes-{{ section.id }} .press-quotes__wrapper {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PressQuotes-{{ section.id }} .press-quotes__wrapper {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Dawn styles every <blockquote> with a left border in base.css. The line is
    always cleared first, then re-added as a divider between columns — so the
    first quote in each row has none, matching the reference.
  {%- endcomment -%}
  #PressQuotes-{{ section.id }} .press-quotes__quote {
    border-left: 0;
    padding-left: 0;
  }

  {%- if section.settings.show_separators -%}
    @media screen and (max-width: 749px) {
      {%- if cols_mobile > 1 -%}
        #PressQuotes-{{ section.id }} .press-quotes__item:not(:nth-child({{ cols_mobile }}n + 1)) .press-quotes__quote {
          border-left: {{ section.settings.separator_thickness }}px solid {{ sep_paint }};
          padding-left: {{ section.settings.separator_padding }}rem;
        }
      {%- endif -%}
    }

    @media screen and (min-width: 750px) {
      {%- if cols > 1 -%}
        #PressQuotes-{{ section.id }} .press-quotes__item:not(:nth-child({{ cols }}n + 1)) .press-quotes__quote {
          border-left: {{ section.settings.separator_thickness }}px solid {{ sep_paint }};
          padding-left: {{ section.settings.separator_padding }}rem;
        }
      {%- endif -%}
    }
  {%- endif -%}
{%- endstyle -%}

<div id="PressQuotes-{{ section.id }}" class="press-quotes color-{{ section.settings.color_scheme }} gradient">
  <div class="press-quotes__wrapper{% unless section.settings.full_width %} page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="press-quotes__heading inline-richtext {{ section.settings.heading_size }} press-quotes__heading--{{ section.settings.alignment }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="press-quotes__grid press-quotes__grid--{{ section.settings.alignment }}">
        {%- for block in section.blocks -%}
          <div
            class="press-quotes__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index0 }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.logo != blank -%}
              {%- comment -%}
                Logos are contained, never cropped: each one keeps its own aspect
                ratio inside a fixed-height box so they all read at the same
                optical size regardless of how wide they are.
              {%- endcomment -%}
              <div class="press-quotes__logo">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="press-quotes__logo-link">
                {%- endif -%}
                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '150, 200, 300, 400, 600',
                    sizes: '200px',
                    alt: block.settings.logo.alt | default: block.settings.quote | escape
                }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <blockquote class="press-quotes__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.press-quotes.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.press-quotes.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-cards.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured-cards.settings.alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.press-quotes.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-cards.settings.layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "t:sections.press-quotes.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.featured-cards.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.featured-cards.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.featured-cards.settings.columns_mobile.label"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.multicolumn.settings.column_gap.label",
      "default": 5
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.multicolumn.settings.row_gap.label",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.featured-cards.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.press-quotes.settings.accent_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_separators",
      "default": false,
      "label": "t:sections.press-quotes.settings.show_separators.label",
      "info": "t:sections.press-quotes.settings.show_separators.info"
    },
    {
      "type": "range",
      "id": "separator_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-banner.settings.border_thickness.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "separator_padding",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "rem",
      "label": "t:sections.press-quotes.settings.separator_padding.label",
      "default": 1
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "t:sections.image-banner.settings.border_color.label",
      "info": "t:sections.image-banner.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "separator_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-banner.settings.border_opacity.label",
      "default": 25
    },
    {
      "type": "header",
      "content": "t:sections.press-quotes.settings.logo_header.content"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:sections.press-quotes.settings.logo_height.label",
      "info": "t:sections.press-quotes.settings.logo_height.info",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.press-quotes.settings.logo_opacity.label",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 0,
      "max": 6,
      "step": 0.2,
      "unit": "rem",
      "label": "t:sections.press-quotes.settings.logo_gap.label",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "t:sections.press-quotes.settings.quote_header.content"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "t:sections.press-quotes.settings.quote_size.label",
      "default": 16
    },
    {
      "type": "range",
      "id": "quote_line_height",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "%",
      "label": "t:sections.press-quotes.settings.quote_line_height.label",
      "default": 150
    },
    {
      "type": "select",
      "id": "quote_weight",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.image-banner.settings_shared.button_weight.options__default.label"
        },
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "default": "inherit",
      "label": "t:sections.press-quotes.settings.quote_weight.label"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "t:sections.press-quotes.settings.quote_color.label",
      "info": "t:sections.featured-cards.settings.text_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.featured-cards.settings.section_padding.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.press-quotes.blocks.quote.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.press-quotes.blocks.quote.settings.logo.label",
          "info": "t:sections.press-quotes.blocks.quote.settings.logo.info"
        },
        {
          "type": "richtext",
          "id": "quote",
          "default": "t:sections.press-quotes.blocks.quote.settings.quote.default",
          "label": "t:sections.press-quotes.blocks.quote.settings.quote.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.press-quotes.blocks.quote.settings.link.label",
          "info": "t:sections.press-quotes.blocks.quote.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.press-quotes.name",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
