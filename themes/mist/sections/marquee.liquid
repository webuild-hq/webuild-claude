{{ 'component-marquee.css' | asset_url | stylesheet_tag }}
{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Marquee-{{ section.id }} {
    --marquee-duration: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.gap }}rem;
    --marquee-text-size: {{ section.settings.text_size | times: 0.75 | round: 0 }}px;
    --marquee-image-size: {{ section.settings.image_size }}rem;
    --marquee-image-radius: {{ section.settings.image_radius }}rem;
    {%- if section.settings.text_color != blank %}
      --marquee-text-color: {{ section.settings.text_color }};
    {%- endif %}
  }

  #Marquee-{{ section.id }} .marquee__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  {%- if section.settings.show_border_top or section.settings.show_border_bottom -%}
    {%- liquid
      assign border_alpha = section.settings.border_opacity | divided_by: 100.0
      if section.settings.border_color != blank
        assign border_paint = section.settings.border_color | color_modify: 'alpha', border_alpha
      else
        assign border_paint = 'rgba(var(--color-foreground), ' | append: border_alpha | append: ')'
      endif
    -%}
    #Marquee-{{ section.id }} {
      {%- if section.settings.show_border_top %}
        border-top: {{ section.settings.border_thickness }}px solid {{ border_paint }};
      {%- endif %}
      {%- if section.settings.show_border_bottom %}
        border-bottom: {{ section.settings.border_thickness }}px solid {{ border_paint }};
      {%- endif %}
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    #Marquee-{{ section.id }} {
      --marquee-text-size: {{ section.settings.text_size }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign direction_class = ''
  if section.settings.direction == 'right'
    assign direction_class = ' marquee--right'
  endif
  assign pause_class = ''
  if section.settings.pause_on_hover
    assign pause_class = ' marquee--pause'
  endif
-%}

<div
  id="Marquee-{{ section.id }}"
  class="marquee color-{{ section.settings.color_scheme }} gradient{{ direction_class }}{{ pause_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="marquee__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="marquee__track">
        {%- comment -%}
          The block list is repeated four times and the track is translated by
          exactly one quarter of its width, which makes the loop seamless. Four
          copies rather than two so a short list still fills a wide screen.
        {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div
            class="marquee__group"
            {% unless forloop.first %}
              aria-hidden="true"
            {% endunless %}
          >
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text' -%}
                  <span class="marquee__item marquee__text" {{ block.shopify_attributes }}>
                    {{- block.settings.text | escape -}}
                  </span>
                {%- when 'image' -%}
                  <div class="marquee__item marquee__image media" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '150, 200, 300, 400, 600',
                          sizes: '200px',
                          alt: block.settings.image.alt | escape
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "t:sections.marquee.settings.speed.label",
      "info": "t:sections.marquee.settings.speed.info",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        { "value": "left", "label": "t:sections.marquee.settings.direction.options__1.label" },
        { "value": "right", "label": "t:sections.marquee.settings.direction.options__2.label" }
      ],
      "default": "left",
      "label": "t:sections.marquee.settings.direction.label"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "t:sections.marquee.settings.pause_on_hover.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.marquee.settings.gap.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.marquee.settings.content_style.content"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "t:sections.marquee.settings.text_size.label",
      "default": 28
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.marquee.settings.text_color.label",
      "info": "t:sections.marquee.settings.text_color.info"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 4,
      "max": 24,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.marquee.settings.image_size.label",
      "default": 10
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "unit": "rem",
      "label": "t:sections.marquee.settings.image_radius.label",
      "default": 1.2
    },
    {
      "type": "header",
      "content": "t:sections.marquee.settings.borders.content"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "default": true,
      "label": "t:sections.image-banner.settings.show_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "default": true,
      "label": "t:sections.image-banner.settings.show_border_bottom.label"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-banner.settings.border_thickness.label",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.image-banner.settings.border_color.label",
      "info": "t:sections.image-banner.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-banner.settings.border_opacity.label",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.featured-cards.settings.section_padding.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.marquee.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.marquee.blocks.text.settings.text.default",
          "label": "t:sections.marquee.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.marquee.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.marquee.blocks.image.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.name",
      "blocks": [
        { "type": "text" },
        { "type": "image" },
        { "type": "text" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
