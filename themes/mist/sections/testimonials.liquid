{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = section.blocks.size
  assign use_slider = false
  if slide_count > 1
    assign use_slider = true
  endif

  assign border_alpha = section.settings.border_opacity | divided_by: 100.0
  if section.settings.border_color != blank
    assign border_paint = section.settings.border_color | color_modify: 'alpha', border_alpha
  else
    assign border_paint = 'rgba(var(--color-foreground), ' | append: border_alpha | append: ')'
  endif
-%}

{%- style -%}
  #Testimonials-{{ section.id }} {
    --tm-gap: {{ section.settings.gap }}rem;
    --tm-image-radius: {{ section.settings.image_radius }}rem;
    --tm-quote-size: {{ section.settings.quote_size }}px;
    --tm-quote-line-height: {{ section.settings.quote_line_height | divided_by: 100.0 }};
    --tm-star-size: {{ section.settings.star_size }}px;
    {%- if section.settings.quote_color != blank %}--tm-quote-color: {{ section.settings.quote_color }};{% endif %}
    {%- if section.settings.star_color != blank %}--tm-star-color: {{ section.settings.star_color }};{% endif %}
    {%- if section.settings.author_color != blank %}--tm-author-color: {{ section.settings.author_color }};{% endif %}
  }

  #Testimonials-{{ section.id }} .testimonials__inner {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Testimonials-{{ section.id }} .testimonials__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.show_border_top or section.settings.show_border_bottom -%}
    #Testimonials-{{ section.id }} {
      {%- if section.settings.show_border_top %}border-top: {{ section.settings.border_thickness }}px solid {{ border_paint }};{% endif %}
      {%- if section.settings.show_border_bottom %}border-bottom: {{ section.settings.border_thickness }}px solid {{ border_paint }};{% endif %}
    }
  {%- endif -%}
{%- endstyle -%}

{%- capture testimonial_slides -%}
  {%- for block in section.blocks -%}
    <div
      class="testimonials__slide{% if use_slider %} slideshow__slide slider__slide grid__item grid--1-col{% endif %} testimonials__slide--image-{{ section.settings.image_position }}"
      {% if use_slider %}
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        role="group"
        aria-roledescription="{{ 'sections.testimonials.testimonial' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ slide_count }}"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <div class="testimonials__text">
        {%- if block.settings.rating > 0 -%}
          <div class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} {{ 'sections.testimonials.of_5_stars' | t }}">
            {%- for i in (1..5) -%}
              <span class="testimonials__star{% if i > block.settings.rating %} testimonials__star--empty{% endif %}" aria-hidden="true">&#9733;</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if block.settings.quote != blank -%}
          <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if block.settings.author != blank -%}
          <p class="testimonials__author">{{ block.settings.author | escape }}</p>
        {%- endif -%}
      </div>

      <div class="testimonials__media-col">
        <div class="testimonials__media media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image.alt | escape
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- liquid
          assign label = block.settings.product_label
          if label == blank
            assign label = block.settings.product.title
          endif
          assign label_url = block.settings.product.url
        -%}
        {%- if label != blank -%}
          {%- if label_url != blank -%}
            <a href="{{ label_url }}" class="testimonials__product-label">{{ label | escape }}</a>
          {%- else -%}
            <p class="testimonials__product-label">{{ label | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div id="Testimonials-{{ section.id }}" class="testimonials color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="testimonials__inner{% unless section.settings.full_width %} page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if use_slider -%}
      {%- comment -%}
        Plain slider-component (SliderComponent), not slideshow-component: the
        latter carries announcement-bar / fade-slideshow logic that interferes
        with a simple horizontal prev/next scroller. This is the same controller
        Dawn uses for its card sliders.
      {%- endcomment -%}
      <slider-component
        class="testimonials__slideshow slider-component"
        role="region"
        aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
        aria-label="{{ 'sections.testimonials.name' | t }}"
      >
        <div class="testimonials__controls slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
        <div
          class="testimonials__track grid grid--1-col slider slider--everywhere"
          id="Slider-{{ section.id }}"
          aria-live="polite"
          aria-atomic="true"
        >
          {{ testimonial_slides }}
        </div>
      </slider-component>

      {%- if section.settings.auto_rotate -%}
        {%- comment -%}
          SliderComponent has no autoplay, so it is driven by clicking the next
          arrow on a timer — that reuses the component's own scroll logic. On the
          last slide the next button is disabled, so it loops back to the start.
          Pauses on hover, on focus, and when the tab is hidden; skipped entirely
          for reduced-motion users.
        {%- endcomment -%}
        <script>
          (() => {
            const root = document.getElementById('Testimonials-{{ section.id }}');
            if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const carousel = root.querySelector('.testimonials__slideshow');
            const scroller = document.getElementById('Slider-{{ section.id }}');
            const next = carousel && carousel.querySelector('button[name="next"]');
            if (!carousel || !scroller || !next) return;

            const speed = {{ section.settings.change_slides_speed | times: 1000 }};
            let timer = null;

            const advance = () => {
              if (next.hasAttribute('disabled')) {
                scroller.scrollTo({ left: 0, behavior: 'smooth' });
              } else {
                next.click();
              }
            };

            const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
            const start = () => { stop(); timer = setInterval(advance, speed); };

            carousel.addEventListener('mouseenter', stop);
            carousel.addEventListener('mouseleave', start);
            carousel.addEventListener('focusin', stop);
            carousel.addEventListener('focusout', start);
            document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

            start();
          })();
        </script>
      {%- endif -%}
    {%- else -%}
      {{ testimonial_slides }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.press-quotes.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-cards.settings.alignment.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.featured-cards.settings.alignment.options__3.label"
        }
      ],
      "default": "right",
      "label": "t:sections.testimonials.settings.image_position.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 2,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.testimonials.settings.gap.label",
      "default": 6
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "unit": "rem",
      "label": "t:sections.image-with-products.settings.media_radius.label",
      "default": 1.6
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.featured-cards.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.autoplay_header.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "default": false,
      "label": "t:sections.testimonials.settings.auto_rotate.label"
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.text_header.content"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "t:sections.testimonials.settings.star_size.label",
      "default": 16
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:sections.testimonials.settings.star_color.label",
      "info": "t:sections.featured-cards.settings.text_color.info"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.press-quotes.settings.quote_size.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "quote_line_height",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "t:sections.press-quotes.settings.quote_line_height.label",
      "default": 120
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "t:sections.press-quotes.settings.quote_color.label",
      "info": "t:sections.featured-cards.settings.text_color.info"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "t:sections.testimonials.settings.author_color.label",
      "info": "t:sections.featured-cards.settings.text_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-products.settings.separators.content"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "default": false,
      "label": "t:sections.image-banner.settings.show_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "default": false,
      "label": "t:sections.image-banner.settings.show_border_bottom.label"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-banner.settings.border_thickness.label",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.image-banner.settings.border_color.label",
      "info": "t:sections.image-banner.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-banner.settings.border_opacity.label",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.featured-cards.settings.section_padding.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating.label",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "quote",
          "default": "t:sections.testimonials.blocks.testimonial.settings.quote.default",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label"
        },
        {
          "type": "text",
          "id": "author",
          "default": "t:sections.testimonials.blocks.testimonial.settings.author.default",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.testimonials.blocks.testimonial.settings.image.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.testimonials.blocks.testimonial.settings.product.label",
          "info": "t:sections.testimonials.blocks.testimonial.settings.product.info"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "t:sections.testimonials.blocks.testimonial.settings.product_label.label",
          "info": "t:sections.testimonials.blocks.testimonial.settings.product_label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
