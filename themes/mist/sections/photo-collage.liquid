{{ 'section-photo-collage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign shadow_alpha = s.shadow_opacity | divided_by: 100.0
-%}

{%- style -%}
  #PhotoCollage-{{ section.id }} {
    --pc-text-width: {{ s.text_width }}%;
    --pc-split-gap: {{ s.split_gap }}px;
    --pc-stage-height: {{ s.stage_height }}px;
    --pc-stage-height-mobile: {{ s.stage_height_mobile }}px;
    --pc-stage-padding: {{ s.stage_padding }}px;

    --pc-overline-size: {{ s.overline_size }}px;
    --pc-overline-spacing: {{ s.overline_spacing | divided_by: 100.0 }}em;
    --pc-overline-gap: {{ s.overline_gap }}px;
    --pc-heading-size: {{ s.heading_size | times: 0.75 | round: 0 }}px;
    --pc-heading-line-height: {{ s.heading_line_height | divided_by: 100.0 }};
    --pc-heading-spacing: {{ s.heading_spacing | divided_by: 100.0 }}em;
    --pc-body-size: {{ s.body_size }}px;
    --pc-body-line-height: {{ s.body_line_height | divided_by: 100.0 }};
    --pc-body-width: {{ s.body_width }}rem;
    --pc-body-gap: {{ s.body_gap }}px;

    --pc-button-size: {{ s.button_size }}px;
    --pc-button-gap: {{ s.button_gap }}px;
    --pc-button-radius: {{ s.button_radius }}px;

    --pc-shadow-y: {{ s.shadow_y }}px;
    --pc-shadow-blur: {{ s.shadow_blur }}px;
    --pc-shadow-opacity: {{ shadow_alpha }};

    {%- if s.overline_weight != 'inherit' %} --pc-overline-weight: {{ s.overline_weight }};{% endif %}
    {%- if s.heading_weight != 'inherit' %} --pc-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.button_weight != 'inherit' %} --pc-button-weight: {{ s.button_weight }};{% endif %}
    {%- if s.overline_color != blank %} --pc-overline-color: {{ s.overline_color }};{% endif %}
    {%- if s.heading_color != blank %} --pc-heading-color: {{ s.heading_color }};{% endif %}
    {%- if s.body_color != blank %} --pc-body-color: {{ s.body_color }};{% endif %}
    {%- if s.button_color != blank %} --pc-button-color: {{ s.button_color }};{% endif %}
  }

  #PhotoCollage-{{ section.id }} .photo-collage__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PhotoCollage-{{ section.id }} {
      --pc-heading-size: {{ s.heading_size }}px;
    }

    #PhotoCollage-{{ section.id }} .photo-collage__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="PhotoCollage-{{ section.id }}"
  class="photo-collage color-{{ s.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="photo-collage__inner{% unless s.full_width %} page-width{% endunless %}">
    <div class="photo-collage__layout photo-collage__layout--media-{{ s.media_position }}">
      <div class="photo-collage__content">
        {%- if s.overline != blank -%}
          <p class="photo-collage__overline">{{ s.overline | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="photo-collage__heading inline-richtext">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="photo-collage__body rte">{{ s.body }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a
            {% if s.button_link != blank %}
              href="{{ s.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="photo-collage__button photo-collage__button--{{ s.button_style }}"
          >
            {{- s.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="photo-collage__stage">
          {%- for block in section.blocks -%}
            {%- liquid
              case block.settings.ratio
                when 'square'
                  assign item_ratio = '1 / 1'
                when 'landscape'
                  assign item_ratio = '4 / 3'
                else
                  assign item_ratio = '3 / 4'
              endcase
            -%}
            {%- capture item_vars -%}
              --item-x: {{ block.settings.position_x }}%;
              --item-y: {{ block.settings.position_y }}%;
              --item-w: {{ block.settings.width }}%;
              --item-ratio: {{ item_ratio }};
              --item-radius: {{ block.settings.radius }}px;
              z-index: {{ forloop.index }};
              {%- if block.settings.image != blank %} --item-focal: {{ block.settings.image.presentation.focal_point }};{% endif -%}
            {%- endcapture -%}
            <div
              class="photo-collage__item{% if s.show_shadow %} photo-collage__item--shadow{% endif %}"
              style="{{ item_vars | strip_newlines }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 500, 700, 1000',
                    sizes: '(min-width: 750px) 40vw, 50vw',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {%- liquid
                  assign placeholder_index = forloop.index | modulo: 2 | plus: 1
                -%}
                {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

