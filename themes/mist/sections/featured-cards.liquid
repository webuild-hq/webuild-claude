{{ 'section-featured-cards.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-button.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shows_price = false
  for block in section.blocks
    if block.settings.show_price
      assign shows_price = true
      break
    endif
  endfor
-%}
{%- if shows_price -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '16 / 9'
  endcase
-%}

{%- style -%}
  #FeaturedCards-{{ section.id }} {
    --cards-columns: {{ section.settings.columns_desktop }};
    --cards-columns-mobile: {{ section.settings.columns_mobile }};
    --cards-gap: {{ section.settings.gap }}rem;
    --cards-radius: {{ section.settings.corner_radius }}rem;
    --cards-ratio: {{ ratio }};
    --cards-padding: {{ section.settings.content_padding }}rem;
    --cards-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cards-text-gap: {{ section.settings.text_gap }}rem;
    --cards-overline-size: {{ section.settings.overline_size }}px;
    --cards-title-size: {{ section.settings.title_size }}px;
    --cards-subtitle-size: {{ section.settings.subtitle_size }}px;
    {%- if section.settings.text_color != blank %}
      --cards-text-color: {{ section.settings.text_color }};
    {%- endif %}

    {%- comment -%}
      Per-element typography. Values are only emitted when the merchant moved
      them off 'Theme default', so anything untouched keeps inheriting.
    {%- endcomment -%}
    {%- if section.settings.overline_weight != 'inherit' %}--cards-overline-weight: {{ section.settings.overline_weight }};{% endif %}
    {%- if section.settings.overline_transform != 'inherit' %}--cards-overline-transform: {{ section.settings.overline_transform }};{% endif %}
    --cards-overline-spacing: {{ section.settings.overline_spacing | divided_by: 100.0 }}em;
    {%- if section.settings.overline_color != blank %}--cards-overline-color: {{ section.settings.overline_color }};{% endif %}

    {%- if section.settings.title_weight != 'inherit' %}--cards-title-weight: {{ section.settings.title_weight }};{% endif %}
    {%- if section.settings.title_transform != 'inherit' %}--cards-title-transform: {{ section.settings.title_transform }};{% endif %}
    --cards-title-spacing: {{ section.settings.title_spacing | divided_by: 100.0 }}em;
    --cards-title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    {%- if section.settings.title_color != blank %}--cards-title-color: {{ section.settings.title_color }};{% endif %}

    {%- if section.settings.subtitle_weight != 'inherit' %}--cards-subtitle-weight: {{ section.settings.subtitle_weight }};{% endif %}
    {%- if section.settings.subtitle_transform != 'inherit' %}--cards-subtitle-transform: {{ section.settings.subtitle_transform }};{% endif %}
    --cards-subtitle-spacing: {{ section.settings.subtitle_spacing | divided_by: 100.0 }}em;
    --cards-subtitle-line-height: {{ section.settings.subtitle_line_height | divided_by: 100.0 }};
    {%- if section.settings.subtitle_color != blank %}--cards-subtitle-color: {{ section.settings.subtitle_color }};{% endif %}

    --cards-btn-size: {{ section.settings.btn_font_size }}px;
    --cards-btn-spacing: {{ section.settings.btn_spacing | divided_by: 100.0 }}em;
    --cards-btn-padding-x: {{ section.settings.btn_padding_x }}rem;
    --cards-btn-padding-y: {{ section.settings.btn_padding_y }}rem;
    {%- if section.settings.btn_transform != 'inherit' %}--cards-btn-transform: {{ section.settings.btn_transform }};{% endif %}

    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.section_heading_size > 0 %}--cards-header-size: {{ section.settings.section_heading_size }}px;{% endif %}
    {%- if section.settings.section_heading_weight != 'inherit' %}--cards-header-weight: {{ section.settings.section_heading_weight }};{% endif %}
    {%- if section.settings.section_heading_transform != 'inherit' %}--cards-header-transform: {{ section.settings.section_heading_transform }};{% endif %}
    {%- if section.settings.section_heading_line_height > 0 %}--cards-header-line-height: {{ section.settings.section_heading_line_height | divided_by: 100.0 }};{% endif %}
    {%- if section.settings.section_heading_color != blank %}--cards-header-color: {{ section.settings.section_heading_color }};{% endif %}
    {%- if section.settings.section_subheading_size > 0 %}--cards-subheader-size: {{ section.settings.section_subheading_size }}px;{% endif %}
    {%- if section.settings.section_subheading_color != blank %}--cards-subheader-color: {{ section.settings.section_subheading_color }};{% endif %}
  }

  #FeaturedCards-{{ section.id }} .featured-cards__wrapper {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #FeaturedCards-{{ section.id }} .featured-cards__wrapper {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FeaturedCards-{{ section.id }}"
  class="featured-cards color-{{ section.settings.color_scheme }} gradient"
>
  <div class="featured-cards__wrapper{% unless section.settings.full_width %} page-width{% endunless %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="featured-cards__header featured-cards__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-cards__heading inline-richtext">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="featured-cards__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="featured-cards__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            comment
              Everything falls back to the product, so the text fields act as
              per-card overrides rather than required input.
            endcomment
            assign card_product = block.settings.product

            assign card_image = block.settings.image
            if card_image == blank
              assign card_image = card_product.featured_image
            endif

            assign card_title = block.settings.title
            if card_title == blank
              assign card_title = card_product.title
            endif

            assign card_link = block.settings.link
            if card_link == blank
              assign card_link = card_product.url
            endif

            assign has_link = false
            if card_link != blank
              assign has_link = true
            endif
          -%}
          <div
            class="featured-card featured-card--{{ block.settings.content_position }} featured-card--align-{{ block.settings.content_alignment }}"
            {% if block.settings.text_color != blank %}
              style="--cards-text-color: {{ block.settings.text_color }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- capture card_sizes -%}
              (min-width: 750px) {{ 100 | divided_by: section.settings.columns_desktop }}vw, 100vw
            {%- endcapture -%}
            <div class="featured-card__media media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: card_sizes,
                    alt: card_image.alt | escape
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if has_link and block.settings.button_label == blank -%}
              {%- comment -%}
                Without a button the whole card becomes the link, so the card
                stays clickable. With a button, only the button links — nesting
                a link inside a link is invalid.
              {%- endcomment -%}
              <a href="{{ card_link }}" class="featured-card__link" aria-label="{{ card_title | escape }}"></a>
            {%- endif -%}

            <div class="featured-card__content">
              {%- if block.settings.overline != blank -%}
                <p class="featured-card__overline">{{ block.settings.overline | escape }}</p>
              {%- endif -%}
              {%- if card_title != blank -%}
                <p class="featured-card__title">{{ card_title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="featured-card__subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
              {%- if block.settings.show_price and card_product != blank -%}
                {%- render 'price', product: card_product, price_class: 'featured-card__price' -%}
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                {%- capture btn_style -%}
                  {%- render 'button-custom-style', settings: section.settings, prefix: 'btn_' -%}
                {%- endcapture -%}
                <a
                  {% if card_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ card_link }}"
                  {% endif %}
                  class="button button--primary featured-card__button{% if section.settings.btn_custom %} button--custom{% endif %}{% if section.settings.btn_full_width %} featured-card__button--full{% endif %}"
                  {%- if btn_style != blank %} style="{{ btn_style | strip_newlines | strip }}"{% endif %}
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

