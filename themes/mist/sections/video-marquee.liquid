{{ 'component-marquee.css' | asset_url | stylesheet_tag }}
{{ 'section-video-marquee.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-button.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  if section.settings.overlay_color != blank
    assign overlay_paint = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  else
    assign overlay_paint = 'rgba(0, 0, 0, ' | append: overlay_alpha | append: ')'
  endif

  assign has_marquee = false
  for block in section.blocks
    if block.type == 'text' or block.type == 'image'
      assign has_marquee = true
      break
    endif
  endfor
-%}

{%- style -%}
  #VideoMarquee-{{ section.id }} {
    --vm-height: {{ section.settings.height }}px;
    --vm-mobile-height: {{ section.settings.mobile_height }}px;
    --vm-overlay: {{ overlay_paint }};
    --marquee-duration: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.gap }}rem;
    --marquee-text-size: {{ section.settings.text_size | times: 0.75 | round: 0 }}px;
    --marquee-image-size: {{ section.settings.image_size }}rem;
    --marquee-image-radius: {{ section.settings.image_radius }}rem;
    --marquee-text-color: {{ section.settings.marquee_text_color | default: '#ffffff' }};
    --vm-subheading-size: {{ section.settings.subheading_size }}px;
    {%- if section.settings.subheading_color != blank %}--vm-subheading-color: {{ section.settings.subheading_color }};{% endif %}
    {%- if section.settings.subheading_weight != 'inherit' %}--vm-subheading-weight: {{ section.settings.subheading_weight }};{% endif %}
    --vm-content-gap: {{ section.settings.content_gap }}rem;
  }

  @media screen and (min-width: 750px) {
    #VideoMarquee-{{ section.id }} {
      --marquee-text-size: {{ section.settings.text_size }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign direction_class = ''
  if section.settings.direction == 'right'
    assign direction_class = ' marquee--right'
  endif
  assign pause_class = ''
  if section.settings.pause_on_hover
    assign pause_class = ' marquee--pause'
  endif
-%}

<div
  id="VideoMarquee-{{ section.id }}"
  class="video-marquee color-{{ section.settings.color_scheme }}{% if section.settings.mobile_image != blank %} video-marquee--has-mobile-image{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- comment -%}
    The cover image is a base layer under the video rather than just a poster:
    it shows while the video loads, and it is what remains visible when the
    video is hidden for reduced-motion users.
  {%- endcomment -%}
  <div class="video-marquee__poster">
    {%- if section.settings.cover_image != blank -%}
      {{
        section.settings.cover_image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.video != blank -%}
    <div class="video-marquee__media">
      {%- comment -%}
        muted is what makes autoplay allowed at all, and playsinline stops iOS
        from taking the video fullscreen on its own.
      {%- endcomment -%}
      {{
        section.settings.video
        | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.mobile_image != blank -%}
    {%- comment -%}
      Shown instead of the video below 750px so phones on cellular data do not
      download several megabytes of video.
    {%- endcomment -%}
    <div class="video-marquee__mobile-media">
      {{
        section.settings.mobile_image
        | image_url: width: 1200
        | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '100vw'
      }}
    </div>
  {%- endif -%}

  <div class="video-marquee__overlay" aria-hidden="true"></div>

  <div class="video-marquee__content video-marquee__content--{{ section.settings.content_position }}">
    {%- if has_marquee -%}
      <div class="video-marquee__strip{{ direction_class }}{{ pause_class }}">
        <div class="marquee__track">
          {%- for i in (1..4) -%}
            <div
              class="marquee__group"
              {% unless forloop.first %}
                aria-hidden="true"
              {% endunless %}
            >
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'text' -%}
                    <span class="marquee__item marquee__text" {{ block.shopify_attributes }}>
                      {{- block.settings.text | escape -}}
                    </span>
                  {%- when 'image' -%}
                    <div class="marquee__item marquee__image media" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 600
                          | image_tag:
                            loading: 'lazy',
                            widths: '150, 200, 300, 400, 600',
                            sizes: '200px',
                            alt: block.settings.image.alt | escape
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank or section.settings.button_label != blank -%}
      <div class="video-marquee__cta">
        {%- if section.settings.subheading != blank -%}
          <p class="video-marquee__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- capture btn_style -%}
            {%- render 'button-custom-style', settings: section.settings, prefix: 'btn_' -%}
          {%- endcapture -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary video-marquee__button{% if section.settings.btn_custom %} button--custom{% endif %}"
            {%- if btn_style != blank %} style="{{ btn_style | strip_newlines | strip }}"{% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.video-marquee.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video-marquee.settings.video.label",
      "info": "t:sections.video-marquee.settings.video.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video-marquee.settings.cover_image.label",
      "info": "t:sections.video-marquee.settings.cover_image.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.video-marquee.settings.mobile_image.label",
      "info": "t:sections.video-marquee.settings.mobile_image.info"
    },
    {
      "type": "range",
      "id": "height",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "t:sections.video-marquee.settings.height.label",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "t:sections.video-marquee.settings.mobile_height.label",
      "default": 420
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.video-marquee.settings.overlay_color.label",
      "info": "t:sections.video-marquee.settings.overlay_color.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:sections.video-marquee.settings.overlay_opacity.label",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.video-marquee.settings.marquee_header.content"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "top", "label": "t:sections.featured-cards.blocks.card.settings.content_position.options__1.label" },
        { "value": "middle", "label": "t:sections.featured-cards.blocks.card.settings.content_position.options__2.label" },
        { "value": "bottom", "label": "t:sections.featured-cards.blocks.card.settings.content_position.options__3.label" }
      ],
      "default": "middle",
      "label": "t:sections.video-marquee.settings.content_position.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "t:sections.marquee.settings.speed.label",
      "info": "t:sections.marquee.settings.speed.info",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        { "value": "left", "label": "t:sections.marquee.settings.direction.options__1.label" },
        { "value": "right", "label": "t:sections.marquee.settings.direction.options__2.label" }
      ],
      "default": "left",
      "label": "t:sections.marquee.settings.direction.label"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "t:sections.marquee.settings.pause_on_hover.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.marquee.settings.gap.label",
      "default": 5
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 90,
      "step": 1,
      "unit": "px",
      "label": "t:sections.marquee.settings.text_size.label",
      "default": 48
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "t:sections.marquee.settings.text_color.label",
      "info": "t:sections.video-marquee.settings.marquee_text_color.info"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 4,
      "max": 24,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.marquee.settings.image_size.label",
      "default": 9
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "unit": "rem",
      "label": "t:sections.marquee.settings.image_radius.label",
      "default": 1.2
    },
    {
      "type": "header",
      "content": "t:sections.video-marquee.settings.cta_header.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "t:sections.video-marquee.settings.subheading.default",
      "label": "t:sections.video-marquee.settings.subheading.label"
    },
    {
      "type": "range",
      "id": "subheading_size",
