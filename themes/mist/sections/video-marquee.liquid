      "info": "t:sections.image-banner.settings_shared.button_custom.info"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "t:sections.image-banner.settings_shared.button_bg.label"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "t:sections.image-banner.settings_shared.button_text.label"
    },
    {
      "type": "color",
      "id": "btn_bg_hover",
      "label": "t:sections.image-banner.settings_shared.button_bg_hover.label"
    },
    {
      "type": "color",
      "id": "btn_text_hover",
      "label": "t:sections.image-banner.settings_shared.button_text_hover.label"
    },
    {
      "type": "color",
      "id": "btn_border",
      "label": "t:sections.image-banner.settings_shared.button_border.label"
    },
    {
      "type": "range",
      "id": "btn_border_thickness",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-banner.settings_shared.button_border_thickness.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-banner.settings_shared.button_radius.label",
      "default": 50
    },
    {
      "type": "select",
      "id": "btn_weight",
      "options": [
        { "value": "inherit", "label": "t:sections.image-banner.settings_shared.button_weight.options__default.label" },
        { "value": "300", "label": "300" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" },
        { "value": "800", "label": "800" },
        { "value": "900", "label": "900" }
      ],
      "default": "600",
      "label": "t:sections.image-banner.settings_shared.button_weight.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-cards.settings.section_padding.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.marquee.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.marquee.blocks.text.settings.text.default",
          "label": "t:sections.marquee.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.marquee.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.marquee.blocks.image.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video-marquee.name",
      "blocks": [
        { "type": "text" },
        { "type": "image" },
        { "type": "text" },
