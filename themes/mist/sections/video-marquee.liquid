        { "value": "inherit", "label": "t:sections.image-banner.settings_shared.button_weight.options__default.label" },
        { "value": "300", "label": "300" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" },
        { "value": "800", "label": "800" },
        { "value": "900", "label": "900" }
      ],
      "default": "inherit",
      "label": "t:sections.video-marquee.settings.subheading_weight.label"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "t:sections.video-marquee.settings.subheading_color.label",
      "info": "t:sections.video-marquee.settings.marquee_text_color.info"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "t:sections.video-marquee.settings.content_gap.label",
      "default": 3
