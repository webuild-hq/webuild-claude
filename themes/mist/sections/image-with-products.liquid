{{ 'section-image-with-products.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-button.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products = section.settings.product_list
  assign products_count = products.count
  assign cols = section.settings.columns | plus: 0

  case section.settings.card_image_ratio
    when 'square'
      assign card_ratio = '1 / 1'
    when 'portrait'
      assign card_ratio = '4 / 5'
    when 'tall'
      assign card_ratio = '3 / 4'
    else
      assign card_ratio = 'auto'
  endcase

  case section.settings.media_ratio
    when 'square'
      assign media_ratio = '1 / 1'
    when 'portrait'
      assign media_ratio = '4 / 5'
    when 'tall'
      assign media_ratio = '3 / 4'
    else
      assign media_ratio = 'auto'
  endcase

  assign sep_alpha = section.settings.separator_opacity | divided_by: 100.0
  if section.settings.separator_color != blank
    assign sep_paint = section.settings.separator_color | color_modify: 'alpha', sep_alpha
  else
    assign sep_paint = 'rgba(var(--color-foreground), ' | append: sep_alpha | append: ')'
  endif
-%}

{%- style -%}
  #ImageProducts-{{ section.id }} {
    --ip-media-width: {{ section.settings.media_width }}%;
    --ip-gap: {{ section.settings.gap }}rem;
    --ip-media-radius: {{ section.settings.media_radius }}rem;
    --ip-media-ratio: {{ media_ratio }};
    --ip-card-ratio: {{ card_ratio }};
    --ip-card-padding: {{ section.settings.card_padding }}rem;
    --ip-card-image-radius: {{ section.settings.card_image_radius }}rem;
    --ip-card-text-gap: {{ section.settings.card_text_gap }}rem;
    --ip-title-size: {{ section.settings.title_size }}px;
    --ip-price-size: {{ section.settings.price_size }}px;
    --ip-btn-size: {{ section.settings.btn_font_size }}px;
    --ip-btn-padding-x: {{ section.settings.btn_padding_x }}rem;
    --ip-btn-padding-y: {{ section.settings.btn_padding_y }}rem;
    --ip-btn-spacing: {{ section.settings.btn_spacing | divided_by: 100.0 }}em;
    {%- if section.settings.title_weight != 'inherit' %}--ip-title-weight: {{ section.settings.title_weight }};{% endif %}
    {%- if section.settings.title_transform != 'inherit' %}--ip-title-transform: {{ section.settings.title_transform }};{% endif %}
    {%- if section.settings.title_color != blank %}--ip-title-color: {{ section.settings.title_color }};{% endif %}
    {%- if section.settings.price_color != blank %}--ip-price-color: {{ section.settings.price_color }};{% endif %}
    {%- if section.settings.btn_transform != 'inherit' %}--ip-btn-transform: {{ section.settings.btn_transform }};{% endif %}
  }

  #ImageProducts-{{ section.id }} .image-products {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ImageProducts-{{ section.id }} .image-products {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #ImageProducts-{{ section.id }} .image-products__grid {
      grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    }

    {%- if section.settings.show_separators -%}
      {%- comment -%}
        The column count is known at render time, so the nth-child rules can be
        written out — that keeps the separators internal only, with no trailing
        line on the last column or row.
      {%- endcomment -%}
      #ImageProducts-{{ section.id }} .image-products__cell:not(:nth-child({{ cols }}n)) {
        border-right: {{ section.settings.separator_thickness }}px solid {{ sep_paint }};
      }

      #ImageProducts-{{ section.id }} .image-products__cell:nth-child(n + {{ cols | plus: 1 }}) {
        border-top: {{ section.settings.separator_thickness }}px solid {{ sep_paint }};
      }
    {%- endif -%}
  }
{%- endstyle -%}

<div id="ImageProducts-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="image-products{% unless section.settings.full_width %} page-width{% endunless %}{% if section.settings.media_position == 'right' %} image-products--media-right{% endif %}{% if section.settings.media_ratio == 'fill' %} image-products--media-fill{% endif %}">
    <div class="image-products__media media">
      {%- if section.settings.image != blank -%}
        {%- capture media_sizes -%}
          (min-width: 750px) {{ section.settings.media_width }}vw, 100vw
        {%- endcapture -%}
        {%- if section.settings.image_link != blank -%}
          <a href="{{ section.settings.image_link }}" class="image-products__media-link">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1400, 2000',
            sizes: media_sizes,
            alt: section.settings.image.alt | escape
        }}
        {%- if section.settings.image_link != blank -%}
          </a>
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if products_count > 0 -%}
      <div class="image-products__grid">
        {%- for product in products -%}
          <div class="image-products__cell">
            <div class="image-products__card">
              <a
                href="{{ product.url }}"
                class="image-products__card-media media"
                aria-label="{{ product.title | escape }}"
                tabindex="-1"
              >
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 750px) 300px, 45vw',
                      alt: product.featured_media.alt | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>

              <div class="image-products__card-info">
                <p class="image-products__card-title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </p>
                {%- if section.settings.show_price -%}
                  {%- render 'price',
                    product: product,
                    price_class: 'image-products__card-price',
                    show_compare_at_price: true
                  -%}
                {%- endif -%}
                {%- if section.settings.button_label != blank -%}
                  {%- capture btn_style -%}
                    {%- render 'button-custom-style', settings: section.settings, prefix: 'btn_' -%}
                  {%- endcapture -%}
                  <a
                    href="{{ product.url }}"
                    class="button button--primary image-products__card-button{% if section.settings.btn_custom %} button--custom{% endif %}"
                    {%- if btn_style != blank %} style="{{ btn_style | strip_newlines | strip }}"{% endif %}
                  >
                    {{- section.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

