{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-button.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Multicolumn-{{ section.id }} {
    --mc-image-radius: {{ section.settings.image_radius }}px;
    --mc-info-gap: {{ section.settings.info_gap }}rem;
    {%- comment -%}
      Dawn sizes grid items with calc(33.33% - var(--grid-*-horizontal-spacing)),
      so the gutter has to be changed through that variable. Overriding
      column-gap alone leaves the widths stale and the last column wraps.
    {%- endcomment -%}
    --grid-desktop-horizontal-spacing: {{ section.settings.column_gap }}px;
    --grid-mobile-horizontal-spacing: {{ section.settings.column_gap | divided_by: 2 }}px;
    --grid-desktop-vertical-spacing: {{ section.settings.row_gap }}px;
    --grid-mobile-vertical-spacing: {{ section.settings.row_gap | divided_by: 2 }}px;
    --mc-title-size: {{ section.settings.column_title_size }}px;
    --mc-text-size: {{ section.settings.column_text_size }}px;
    {%- if section.settings.column_title_weight != 'inherit' %}--mc-title-weight: {{ section.settings.column_title_weight }};{% endif %}
    {%- if section.settings.column_title_transform != 'inherit' %}--mc-title-transform: {{ section.settings.column_title_transform }};{% endif %}
    {%- if section.settings.column_title_color != blank %}--mc-title-color: {{ section.settings.column_title_color }};{% endif %}
    {%- if section.settings.column_text_color != blank %}--mc-text-color: {{ section.settings.column_text_color }};{% endif %}
    --mc-btn-size: {{ section.settings.btn_font_size }}px;
    --mc-btn-padding-x: {{ section.settings.btn_padding_x }}rem;
    --mc-btn-padding-y: {{ section.settings.btn_padding_y }}rem;
    --mc-btn-spacing: {{ section.settings.btn_spacing | divided_by: 100.0 }}em;
    {%- if section.settings.btn_transform != 'inherit' %}--mc-btn-transform: {{ section.settings.btn_transform }};{% endif %}
  }

  {%- comment -%}
    Dawn pads the card on all sides when it has a background, but strips the
    side padding when it has none so the text lines up with the grid edge. The
    setting follows both behaviours instead of forcing padding everywhere.
  {%- endcomment -%}
  {%- unless section.settings.background_style == 'none' -%}
    #Multicolumn-{{ section.id }} .multicolumn-card__info {
      padding: {{ section.settings.card_padding }}px;
    }

    {%- comment -%}
      The image wrapper carries its own hardcoded 2.5rem spacing, separate from
      the info padding — without this the image keeps its inset at 0.
    {%- endcomment -%}
    #Multicolumn-{{ section.id }} .multicolumn-card-spacing {
      padding-top: {{ section.settings.card_padding }}px;
    }

    {%- comment -%}
      Side margins are left alone on centered partial-width images: Dawn centers
      those with margin:auto, and overriding it would push them off-centre.
    {%- endcomment -%}
    #Multicolumn-{{ section.id }} .multicolumn-list__item:not(.center) .multicolumn-card-spacing,
    #Multicolumn-{{ section.id }} .multicolumn-card-spacing.multicolumn-card__image-wrapper--full-width {
      margin-left: {{ section.settings.card_padding }}px;
      margin-right: {{ section.settings.card_padding }}px;
    }
  {%- endunless -%}

  {%- comment -%}
    The image-to-title gap is its own setting. The adjacent-sibling selector
    means it only applies when the column actually has an image — otherwise the
    card padding above keeps driving the top inset.
  {%- endcomment -%}
  #Multicolumn-{{ section.id }} .multicolumn-card__image-wrapper + .multicolumn-card__info {
    padding-top: {{ section.settings.image_text_gap }}px;
  }

  #Multicolumn-{{ section.id }} .multicolumn-card__image,
  #Multicolumn-{{ section.id }} .multicolumn-card__image-wrapper .media {
    border-radius: {{ section.settings.image_radius }}px;
  }

  #Multicolumn-{{ section.id }} .multicolumn-card__image {
    object-position: {{ section.settings.image_focal_point }};
  }

  {%- if section.settings.image_ratio == 'custom' -%}
    {%- comment -%}
      Dawn's ratio classes use a padding-bottom hack, so the custom ratio is
      expressed as height relative to width — 100% is square, more is taller.
    {%- endcomment -%}
    #Multicolumn-{{ section.id }} .multicolumn-card__image-wrapper .media {
      padding-bottom: {{ section.settings.image_custom_ratio }}%;
    }
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div
  id="Multicolumn-{{ section.id }}"
  class="multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}"
>
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container">
              {%- if block.settings.image != blank -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                {%- if block.settings.title != blank -%}
                  <h3 class="inline-richtext multicolumn-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte multicolumn-card__text">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  {%- if section.settings.link_style == 'button' -%}
                    {%- capture mc_btn_style -%}
                      {%- render 'button-custom-style', settings: section.settings, prefix: 'btn_' -%}
                    {%- endcapture -%}
                    <a
                      class="button multicolumn-card__button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}{% if section.settings.btn_custom %} button--custom{% endif %}"
                      {% if block.settings.link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.link }}"
                      {% endif %}
                      {%- if mc_btn_style != blank %} style="{{ mc_btn_style | strip_newlines | strip }}"{% endif %}
                    >
                      {{- block.settings.link_label | escape -}}
                    </a>
                  {%- else -%}
                    <a
                      class="link animate-arrow"
                      {% if block.settings.link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.link }}"
                      {% endif %}
                    >
                      {{- block.settings.link_label | escape -}}
                      <span class="svg-wrapper"
                        ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                      >
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_image.content"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:sections.multicolumn.settings.image_ratio.options__custom.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "image_custom_ratio",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "t:sections.multicolumn.settings.image_custom_ratio.label",
      "info": "t:sections.multicolumn.settings.image_custom_ratio.info",
      "default": 125
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_radius.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "options": [
        {
          "value": "top left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_left.label"
        },
        {
          "value": "top center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_center.label"
        },
        {
          "value": "top right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_right.label"
        },
        {
          "value": "center left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_left.label"
        },
        {
          "value": "center center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_center.label"
        },
        {
          "value": "center right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_right.label"
        },
        {
          "value": "bottom left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_left.label"
        },
        {
          "value": "bottom center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_center.label"
        },
        {
          "value": "bottom right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_right.label"
        }
      ],
      "default": "center center",
      "label": "t:sections.image-with-text.settings.image_focal_point.label",
      "info": "t:sections.image-with-text.settings.image_focal_point.info"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label",
      "info": "t:sections.multicolumn.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.multicolumn.settings.background_style.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.spacing.content"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.column_gap.label",
      "info": "t:sections.multicolumn.settings.column_gap.info",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.row_gap.label",
      "info": "t:sections.multicolumn.settings.row_gap.info",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.card_padding.label",
      "info": "t:sections.multicolumn.settings.card_padding.info",
      "default": 25
    },
    {
      "type": "range",
      "id": "image_text_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.image_text_gap.label",
      "default": 25
    },
    {
      "type": "range",
      "id": "info_gap",
      "min": 0,
      "max": 4,
      "step": 0.2,
      "unit": "rem",
      "label": "t:sections.multicolumn.settings.info_gap.label",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.column_text.content"
    },
    {
      "type": "range",
      "id": "column_title_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.column_title_size.label",
      "default": 20
    },
    {
      "type": "select",
      "id": "column_title_weight",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.image-banner.settings_shared.button_weight.options__default.label"
        },
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        },
        {
          "value": "900",
          "label": "900"
        }
      ],
      "default": "inherit",
      "label": "t:sections.multicolumn.settings.column_title_weight.label"
    },
    {
      "type": "select",
      "id": "column_title_transform",
      "options": [
