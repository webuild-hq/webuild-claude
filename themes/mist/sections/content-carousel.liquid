{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-content-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  case s.image_ratio
    when 'portrait'
      assign cc_ratio = '3 / 4'
    when 'landscape'
      assign cc_ratio = '4 / 3'
    else
      assign cc_ratio = '1 / 1'
  endcase

  comment
    A fractional slide count is what produces the peek: 3 columns with a 30%
    peek means 3.3 slides fit the viewport, leaving a third of a card showing.
  endcomment
  assign peek = s.peek_amount | divided_by: 100.0
  assign visible_desktop = s.columns_desktop | plus: peek
  assign visible_mobile = s.columns_mobile | plus: peek
-%}

{%- style -%}
  #ContentCarousel-{{ section.id }} {
    --cc-visible: {{ visible_mobile }};
    --cc-gap: {{ s.gap | times: 0.6 | round: 0 }}px;
    --cc-edge: {{ s.edge_padding | times: 0.6 | round: 0 }}px;
    --cc-ratio: {{ cc_ratio }};
    --cc-media-radius: {{ s.media_radius }}px;
    --cc-media-gap: {{ s.media_gap }}px;
    --cc-text-align: {{ s.text_align }};

    --cc-title-size: {{ s.title_size }}px;
    --cc-title-line-height: {{ s.title_line_height | divided_by: 100.0 }};
    --cc-title-spacing: {{ s.title_spacing | divided_by: 100.0 }}em;
    --cc-title-gap: {{ s.title_gap }}px;
    {%- if s.title_weight != 'inherit' %} --cc-title-weight: {{ s.title_weight }};{% endif %}
    {%- if s.title_transform != 'inherit' %} --cc-title-transform: {{ s.title_transform }};{% endif %}
    {%- if s.title_color != blank %} --cc-title-color: {{ s.title_color }};{% endif %}

    --cc-text-size: {{ s.text_size }}px;
    --cc-text-line-height: {{ s.text_line_height | divided_by: 100.0 }};
    {%- if s.text_color != blank %} --cc-text-color: {{ s.text_color }};{% endif %}

    --cc-link-size: {{ s.link_size }}px;
    --cc-link-gap: {{ s.link_gap }}px;
    {%- if s.link_color != blank %} --cc-link-color: {{ s.link_color }};{% endif %}

    --cc-heading-size: {{ s.heading_size | times: 0.75 | round: 0 }}px;
    --cc-heading-gap: {{ s.heading_gap }}px;
    --cc-heading-align: {{ s.heading_align }};
    {%- if s.heading_weight != 'inherit' %} --cc-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.heading_color != blank %} --cc-heading-color: {{ s.heading_color }};{% endif %}

    --cc-arrow-size: {{ s.arrow_size }}px;
    --cc-arrow-icon-size: {{ s.arrow_icon_size }}px;
    --cc-arrow-top: {{ s.arrow_top }}%;
    --cc-arrow-offset: {{ s.arrow_offset }}px;
    --cc-arrow-border-width: {{ s.arrow_border_width }}px;
    {%- if s.arrow_border_color != blank %} --cc-arrow-border-color: {{ s.arrow_border_color }};{% endif %}
    {%- if s.arrow_border_color_hover != blank %} --cc-arrow-border-color-hover: {{ s.arrow_border_color_hover }};{% endif %}
    {%- if s.arrow_bg != blank %} --cc-arrow-bg: {{ s.arrow_bg }};{% endif %}
    {%- if s.arrow_bg_hover != blank %} --cc-arrow-bg-hover: {{ s.arrow_bg_hover }};{% endif %}
    {%- if s.arrow_color != blank %} --cc-arrow-color: {{ s.arrow_color }};{% endif %}
  }

  #ContentCarousel-{{ section.id }} .content-carousel__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ContentCarousel-{{ section.id }} {
      --cc-visible: {{ visible_desktop }};
      --cc-gap: {{ s.gap }}px;
      --cc-edge: {{ s.edge_padding }}px;
      --cc-heading-size: {{ s.heading_size }}px;
    }

    #ContentCarousel-{{ section.id }} .content-carousel__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="ContentCarousel-{{ section.id }}"
  class="content-carousel color-{{ s.color_scheme }} gradient{% if s.hide_arrows_mobile %} content-carousel--hide-arrows-mobile{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="content-carousel__inner{% unless s.full_width %} page-width{% endunless %}">
    {%- if s.heading != blank -%}
      <h2 class="content-carousel__heading inline-richtext">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <slider-component class="content-carousel__slider">
        <ul
          id="Slider-{{ section.id }}"
          class="content-carousel__track slider slider--everywhere"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign media_style = ''
              if s.image_ratio == 'adapt' and block.settings.image != blank
                assign media_style = 'aspect-ratio: ' | append: block.settings.image.aspect_ratio | append: ';'
              endif
            -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="content-carousel__slide slider__slide"
              {{ block.shopify_attributes }}
            >
              <div
                class="content-carousel__media"
                {% if media_style != blank or block.settings.image != blank %}
                  style="{{ media_style }}{% if block.settings.image != blank %} --cc-focal: {{ block.settings.image.presentation.focal_point }};{% endif %}"
                {% endif %}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 750px) 33vw, 90vw',
                      alt: block.settings.image.alt | escape
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="content-carousel__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="content-carousel__title inline-richtext">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="content-carousel__card-link">
                        <span class="visually-hidden">{{ block.settings.title | strip_html | escape }}</span>
                      </a>
                    {%- endif -%}
                    {{ block.settings.title }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="content-carousel__text rte">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                  <span class="content-carousel__link link">{{ block.settings.link_label | escape }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if s.show_arrows -%}
          <button
            type="button"
            class="content-carousel__button content-carousel__button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="button"
            class="content-carousel__button content-carousel__button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
      </slider-component>
    {%- endif -%}
  </div>
</div>

