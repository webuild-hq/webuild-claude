{{ 'section-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings

  assign divider_alpha = s.divider_opacity | divided_by: 100.0
  if s.divider_color != blank
    assign divider_paint = s.divider_color | color_modify: 'alpha', divider_alpha
  else
    assign divider_paint = 'rgba(var(--color-foreground), ' | append: divider_alpha | append: ')'
  endif

  assign list_classes = ''
  if s.show_divider_top
    assign list_classes = list_classes | append: ' faq__list--divider-top'
  endif
  if s.show_divider_between == false
    assign list_classes = list_classes | append: ' faq__list--no-dividers'
  elsif s.show_divider_bottom == false
    assign list_classes = list_classes | append: ' faq__list--divider-bottom'
  endif
-%}

{%- style -%}
  #Faq-{{ section.id }} {
    --faq-heading-size: {{ s.heading_size | times: 0.75 | round: 0 }}px;
    --faq-heading-line-height: {{ s.heading_line_height | divided_by: 100.0 }};
    --faq-heading-spacing: {{ s.heading_spacing | divided_by: 100.0 }}em;
    --faq-heading-align: {{ s.heading_align }};
    {%- if s.heading_weight != 'inherit' %} --faq-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.heading_color != blank %} --faq-heading-color: {{ s.heading_color }};{% endif %}
    --faq-subheading-size: {{ s.subheading_size }}px;
    --faq-subheading-gap: {{ s.subheading_gap }}px;
    {%- if s.subheading_color != blank %} --faq-subheading-color: {{ s.subheading_color }};{% endif %}

    --faq-question-size: {{ s.question_size }}px;
    --faq-question-line-height: {{ s.question_line_height | divided_by: 100.0 }};
    {%- if s.question_weight != 'inherit' %} --faq-question-weight: {{ s.question_weight }};{% endif %}
    {%- if s.question_color != blank %} --faq-question-color: {{ s.question_color }};{% endif %}
    {%- if s.question_color_hover != blank %} --faq-question-color-hover: {{ s.question_color_hover }};{% endif %}
    --faq-row-padding-y: {{ s.row_padding_y }}px;

    --faq-answer-size: {{ s.answer_size }}px;
    --faq-answer-line-height: {{ s.answer_line_height | divided_by: 100.0 }};
    --faq-answer-padding-bottom: {{ s.answer_padding_bottom }}px;
    --faq-answer-padding-right: {{ s.answer_padding_right }}px;
    {%- if s.answer_color != blank %} --faq-answer-color: {{ s.answer_color }};{% endif %}

    --faq-icon-size: {{ s.icon_size }}px;
    --faq-icon-thickness: {{ s.icon_thickness }}px;
    --faq-icon-gap: {{ s.icon_gap }}px;
    {%- if s.icon_color != blank %} --faq-icon-color: {{ s.icon_color }};{% endif %}

    --faq-divider-width: {{ s.divider_thickness }}px;
    --faq-divider-color: {{ divider_paint }};

    --faq-speed: {{ s.animation_speed }}ms;
    --faq-layout-gap: {{ s.layout_gap }}px;
    {%- if s.list_width > 0 %} --faq-list-width: {{ s.list_width }}rem;{% endif %}
    --faq-split-width: {{ s.split_width }}%;
    --faq-split-gap: {{ s.split_gap }}px;
    --faq-cta-align: {{ s.heading_align }};
  }

  #Faq-{{ section.id }} .faq__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Faq-{{ section.id }} {
      --faq-heading-size: {{ s.heading_size }}px;
    }

    #Faq-{{ section.id }} .faq__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="Faq-{{ section.id }}"
  class="faq color-{{ s.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="faq__inner{% unless s.full_width %} page-width{% endunless %}">
    <div class="faq__layout faq__layout--{{ s.layout }}{% if s.sticky_heading %} faq__layout--sticky{% endif %}">
      <div class="faq__header">
        {%- if s.heading != blank -%}
          <h2 class="faq__heading inline-richtext">{{ s.heading }}</h2>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <div class="faq__subheading rte">{{ s.subheading }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <accordion-rows
          class="faq__list{{ list_classes }}"
          data-single-open="{{ s.single_open }}"
          data-speed="{{ s.animation_speed }}"
          data-deep-links="{{ s.enable_deep_links }}"
        >
          {%- if s.show_search -%}
            <div class="faq__search">
              <input
                type="search"
                class="faq__search-input" data-accordion-search
                placeholder="{{ s.search_placeholder | escape }}"
                aria-label="{{ s.search_placeholder | escape }}"
              >
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- liquid
              comment
                Handleized questions give shareable anchors like #faq-do-you-ship-worldwide,
                which is what makes a support link land on the right answer.
              endcomment
              assign anchor = block.settings.question | strip_html | handleize
              if anchor == blank
                assign anchor = 'faq-' | append: forloop.index
              else
                assign anchor = 'faq-' | append: anchor
              endif
            -%}
            <details
              id="{{ anchor }}"
              class="faq__item faq__item--icon-{{ s.icon_position }}"
              {% if s.open_first and forloop.first %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="faq__question">
                <span class="faq__question-text">{{ block.settings.question }}</span>
                {%- case s.icon_style -%}
                  {%- when 'plus' -%}
                    <span class="faq__icon faq__icon--plus" aria-hidden="true"></span>
                  {%- when 'chevron' -%}
                    <span class="faq__icon faq__icon--chevron" aria-hidden="true">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  {%- when 'arrow' -%}
                    <span class="faq__icon faq__icon--arrow" aria-hidden="true">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                {%- endcase -%}
              </summary>
              <div class="faq__answer-wrap" data-accordion-panel>
                <div class="faq__answer rte">{{ block.settings.answer }}</div>
              </div>
            </details>
          {%- endfor -%}

          {%- if s.show_search -%}
            <p class="faq__no-results" data-accordion-empty hidden>{{ s.no_results_text | escape }}</p>
          {%- endif -%}

          {%- if s.cta_text != blank or s.cta_label != blank -%}
            <div class="faq__cta">
              {%- if s.cta_text != blank -%}
                <p class="faq__cta-text">{{ s.cta_text | escape }}</p>
              {%- endif -%}
              {%- if s.cta_label != blank -%}
                <a
                  {% if s.cta_link != blank %}
                    href="{{ s.cta_link }}"
                  {% else %}
                    href="#"
                    aria-disabled="true"
                  {% endif %}
                  class="button"
                >
                  {{- s.cta_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </accordion-rows>
      {%- endif -%}
    </div>
  </div>
</div>

