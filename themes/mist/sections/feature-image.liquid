{{ 'section-feature-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  case s.media_ratio
    when 'portrait'
      assign fi_ratio = '3 / 4'
    when 'landscape'
      assign fi_ratio = '4 / 3'
    else
      assign fi_ratio = '1 / 1'
  endcase
-%}

{%- style -%}
  #FeatureImage-{{ section.id }} {
    --fi-media-width: {{ s.media_width }}%;
    --fi-split-gap: {{ s.split_gap }}px;
    --fi-ratio: {{ fi_ratio }};
    --fi-media-radius: {{ s.media_radius }}px;
    --fi-stage-padding: {{ s.stage_padding }}px;
    --fi-stage-padding-mobile: {{ s.stage_padding | times: 0.6 | round: 0 }}px;
    --fi-badge-scale-mobile: {{ s.badge_scale_mobile | divided_by: 100.0 }};

    --fi-overline-size: {{ s.overline_size }}px;
    --fi-overline-spacing: {{ s.overline_spacing | divided_by: 100.0 }}em;
    --fi-overline-gap: {{ s.overline_gap }}px;
    --fi-heading-size: {{ s.heading_size | times: 0.75 | round: 0 }}px;
    --fi-heading-line-height: {{ s.heading_line_height | divided_by: 100.0 }};
    --fi-heading-spacing: {{ s.heading_spacing | divided_by: 100.0 }}em;
    --fi-body-size: {{ s.body_size }}px;
    --fi-body-line-height: {{ s.body_line_height | divided_by: 100.0 }};
    --fi-body-gap: {{ s.body_gap }}px;

    --fi-button-height: {{ s.button_height }}px;
    --fi-button-radius: {{ s.button_radius }}px;
    --fi-button-size: {{ s.button_size }}px;
    --fi-button-icon-size: {{ s.button_icon_size }}px;
    --fi-button-margin: {{ s.button_margin }}px;

    {%- if s.overline_weight != 'inherit' %} --fi-overline-weight: {{ s.overline_weight }};{% endif %}
    {%- if s.heading_weight != 'inherit' %} --fi-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.button_weight != 'inherit' %} --fi-button-weight: {{ s.button_weight }};{% endif %}
    {%- if s.overline_color != blank %} --fi-overline-color: {{ s.overline_color }};{% endif %}
    {%- if s.heading_color != blank %} --fi-heading-color: {{ s.heading_color }};{% endif %}
    {%- if s.body_color != blank %} --fi-body-color: {{ s.body_color }};{% endif %}
    {%- if s.button_icon_bg != blank %} --fi-button-icon-bg: {{ s.button_icon_bg }};{% endif %}
    {%- if s.button_icon_color != blank %} --fi-button-icon-color: {{ s.button_icon_color }};{% endif %}
  }

  #FeatureImage-{{ section.id }} .feature-image__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #FeatureImage-{{ section.id }} {
      --fi-heading-size: {{ s.heading_size }}px;
    }

    #FeatureImage-{{ section.id }} .feature-image__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FeatureImage-{{ section.id }}"
  class="feature-image color-{{ s.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="feature-image__inner{% unless s.full_width %} page-width{% endunless %}">
    <div class="feature-image__layout feature-image__layout--media-{{ s.media_position }}">
      <div class="feature-image__stage">
        <div
          class="feature-image__media feature-image__media--{{ s.media_shape }}"
          {% if s.image != blank %}
            style="--fi-focal: {{ s.image.presentation.focal_point }};"
          {% endif %}
        >
          {%- if s.image != blank -%}
            {{
              s.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 750px) 50vw, 90vw',
                alt: s.image.alt | escape
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- capture badge_vars -%}
            --badge-x: {{ block.settings.position_x }}%;
            --badge-y: {{ block.settings.position_y }}%;
            --badge-size: {{ block.settings.size }}px;
            --badge-rotate: {{ block.settings.rotation }}deg;
            --badge-font-size: {{ block.settings.font_size }}px;
            {%- if block.settings.background != blank %} --badge-bg: {{ block.settings.background }};{% endif -%}
            {%- if block.settings.text_color != blank %} --badge-color: {{ block.settings.text_color }};{% endif -%}
            {%- if block.settings.font_weight != 'inherit' %} --badge-weight: {{ block.settings.font_weight }};{% endif -%}
          {%- endcapture -%}
          <div class="feature-image__badge" style="{{ badge_vars | strip_newlines }}" {{ block.shopify_attributes }}>
            {%- comment -%}
              The shape is an inline SVG rather than a clip-path so the scalloped
              edge stays exact at any size and the label is never clipped along
              with it. preserveAspectRatio is left at its default so a square
              viewBox always maps onto the square badge box.
            {%- endcomment -%}
            <svg class="feature-image__badge-shape" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              {%- case block.settings.shape -%}
                {%- when 'circle' -%}
                  <circle cx="50" cy="50" r="50" fill="currentColor" />
                {%- when 'squircle' -%}
                  <rect x="0" y="0" width="100" height="100" rx="28" fill="currentColor" />
                {%- else -%}
                  <path d="M 90.00 50.00 A 10.35 10.35 0 0 1 84.64 70.00 A 10.35 10.35 0 0 1 70.00 84.64 A 10.35 10.35 0 0 1 50.00 90.00 A 10.35 10.35 0 0 1 30.00 84.64 A 10.35 10.35 0 0 1 15.36 70.00 A 10.35 10.35 0 0 1 10.00 50.00 A 10.35 10.35 0 0 1 15.36 30.00 A 10.35 10.35 0 0 1 30.00 15.36 A 10.35 10.35 0 0 1 50.00 10.00 A 10.35 10.35 0 0 1 70.00 15.36 A 10.35 10.35 0 0 1 84.64 30.00 A 10.35 10.35 0 0 1 90.00 50.00 Z" fill="currentColor" />
              {%- endcase -%}
            </svg>
            <span class="feature-image__badge-text">{{ block.settings.text | escape }}</span>
          </div>
        {%- endfor -%}
      </div>

      <div class="feature-image__content">
        {%- if s.overline != blank -%}
          <p class="feature-image__overline">{{ s.overline | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="feature-image__heading inline-richtext">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="feature-image__body rte">{{ s.body }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a
            {% if s.button_link != blank %}
              href="{{ s.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="feature-image__button button"
          >
            <span>{{ s.button_label | escape }}</span>
            {%- if s.button_show_icon -%}
              <span class="feature-image__button-icon" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

