{{ 'section-promise.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  case s.mobile_ratio
    when 'square'
      assign mobile_ratio = '1 / 1'
    when 'portrait'
      assign mobile_ratio = '3 / 4'
    when 'wide'
      assign mobile_ratio = '16 / 9'
    else
      assign mobile_ratio = '4 / 3'
  endcase

  comment
    'auto' keeps the current behaviour: no ratio, the image simply stretches to
    match the text panel's height. Any other value gives it a size of its own,
    independent of how much text sits beside it.
  endcomment
  case s.desktop_ratio
    when 'square'
      assign desktop_ratio = '1 / 1'
    when 'portrait'
      assign desktop_ratio = '3 / 4'
    when 'landscape'
      assign desktop_ratio = '4 / 3'
    when 'wide'
      assign desktop_ratio = '16 / 9'
    else
      assign desktop_ratio = 'auto'
  endcase

  case s.vertical_align
    when 'top'
      assign vertical_align = 'flex-start'
    when 'bottom'
      assign vertical_align = 'flex-end'
    else
      assign vertical_align = 'center'
  endcase

  assign divider_alpha = s.divider_opacity | divided_by: 100.0
  if s.divider_color != blank
    assign divider_paint = s.divider_color | color_modify: 'alpha', divider_alpha
  else
    assign divider_paint = 'rgba(var(--color-foreground), ' | append: divider_alpha | append: ')'
  endif
-%}

{%- style -%}
  #Promise-{{ section.id }} {
    --pr-radius: {{ s.corner_radius }}px;
    --pr-text-col: {{ s.text_column_width }}%;
    --pr-vertical-align: {{ vertical_align }};
    --pr-content-width: {{ s.content_width }}rem;
    --pr-mobile-ratio: {{ mobile_ratio }};
    --pr-desktop-ratio: {{ desktop_ratio }};
    {%- comment -%}
      A definite height always wins over both the ratio above and the grid's
      stretch behaviour — no extra CSS needed to make it "take". 0 means
      disabled: 'auto' lets the ratio (or the stretch, on desktop) keep
      governing the image as before.
    {%- endcomment -%}
    --pr-height: {% if s.image_height > 0 %}{{ s.image_height }}px{% else %}auto{% endif %};
    --pr-mobile-height: {% if s.image_height_mobile > 0 %}{{ s.image_height_mobile }}px{% elsif s.image_height > 0 %}{{ s.image_height }}px{% else %}auto{% endif %};

    --pr-heading-size: {{ s.heading_size | times: 0.7 | round: 0 }}px;
    --pr-heading-line-height: {{ s.heading_line_height | divided_by: 100.0 }};
    --pr-heading-spacing: {{ s.heading_spacing | divided_by: 100.0 }}em;
    {%- if s.heading_weight != 'inherit' %} --pr-heading-weight: {{ s.heading_weight }};{% endif %}
    {%- if s.heading_transform != 'inherit' %} --pr-heading-transform: {{ s.heading_transform }};{% endif %}
    {%- if s.heading_color != blank %} --pr-heading-color: {{ s.heading_color }};{% endif %}

    --pr-divider-width: {{ s.divider_width }}%;
    --pr-divider-thickness: {{ s.divider_thickness }}px;
    --pr-divider-color: {{ divider_paint }};
    --pr-divider-gap-top: {{ s.divider_gap_top }}px;
    --pr-divider-gap-bottom: {{ s.divider_gap_bottom }}px;

    --pr-item-size: {{ s.item_size }}px;
    --pr-item-line-height: {{ s.item_line_height | divided_by: 100.0 }};
    --pr-item-gap: {{ s.item_gap }}px;
    {%- if s.item_weight != 'inherit' %} --pr-item-weight: {{ s.item_weight }};{% endif %}
    {%- if s.item_color != blank %} --pr-item-color: {{ s.item_color }};{% endif %}

    --pr-marker-size: {{ s.marker_size }}px;
    --pr-marker-thickness: {{ s.marker_thickness }}px;
    --pr-marker-gap: {{ s.marker_gap }}px;
    {%- if s.marker_color != blank %} --pr-marker-color: {{ s.marker_color }};{% endif %}

    {%- comment -%} Panels are cramped on phones, so the spacing is eased back. {%- endcomment -%}
    --pr-pad-x: {{ s.panel_padding_x | times: 0.6 | round: 0 }}px;
    --pr-pad-y: {{ s.panel_padding_y | times: 0.6 | round: 0 }}px;
  }

  #Promise-{{ section.id }} .promise__inner {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Promise-{{ section.id }} {
      --pr-heading-size: {{ s.heading_size }}px;
      --pr-pad-x: {{ s.panel_padding_x }}px;
      --pr-pad-y: {{ s.panel_padding_y }}px;
      {%- if s.min_height > 0 %} --pr-min-height: {{ s.min_height }}px;{% endif %}
    }

    #Promise-{{ section.id }} .promise__inner {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="Promise-{{ section.id }}"
  class="promise{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="promise__inner{% unless s.full_width %} page-width{% endunless %}">
    <div
      class="promise__grid promise__grid--media-{{ s.media_position }}{% if s.mobile_media_first %} promise__grid--mobile-media-first{% endif %}"
    >
      <div class="promise__panel color-{{ s.color_scheme }} gradient">
        <div class="promise__content promise__content--{{ s.content_alignment }}">
          {%- if s.heading != blank -%}
            <h2 class="promise__heading inline-richtext">{{ s.heading }}</h2>
          {%- endif -%}

          {%- if s.show_divider -%}
            <div class="promise__divider" role="separator"></div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="promise__list" role="list">
              {%- for block in section.blocks -%}
                <li class="promise__item" {{ block.shopify_attributes }}>
                  {%- case s.marker_style -%}
                    {%- when 'dot' -%}
                      <span class="promise__marker promise__marker--dot" aria-hidden="true"></span>
                    {%- when 'dash' -%}
                      <span class="promise__marker promise__marker--dash" aria-hidden="true"></span>
                    {%- when 'check' -%}
                      <span class="promise__marker promise__marker--check" aria-hidden="true">
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      </span>
                  {%- endcase -%}
                  <span class="promise__text">{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <div
        class="promise__media{% unless s.desktop_ratio == 'auto' %} promise__media--sized{% endunless %}"
        {%- if s.image != blank %} style="--pr-focal: {{ s.image.presentation.focal_point }};"{% endif %}
      >
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: s.image.alt | escape
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

