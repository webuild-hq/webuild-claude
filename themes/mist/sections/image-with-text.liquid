{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-button.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img_border_alpha = section.settings.image_border_opacity | divided_by: 100.0
  assign img_overlay_alpha = section.settings.image_overlay_opacity | divided_by: 100.0
  assign content_border_alpha = section.settings.content_border_opacity | divided_by: 100.0
-%}

{%- style -%}
  {%- comment -%}
    global-media-settings reads these variables, so overriding them here scopes
    the theme's media styling to this section only.
  {%- endcomment -%}
  #ImageWithTextMedia-{{ section.id }} {
    --media-radius: {{ section.settings.image_radius }}px;
    --media-border-width: {{ section.settings.image_border_thickness }}px;
    --media-border-opacity: {{ img_border_alpha }};
    --media-shadow-opacity: {{ section.settings.image_shadow_opacity | divided_by: 100.0 }};
    --media-shadow-blur-radius: {{ section.settings.image_shadow_blur }}px;
    --media-shadow-visible: {% if section.settings.image_shadow_opacity > 0 %}1{% else %}0{% endif %};
  }

  {%- comment -%}
    The border is a real `border` on .global-media-settings, so it is overridden
    directly — recolouring via --color-foreground would also repaint the
    placeholder and anything else inheriting it.
  {%- endcomment -%}
  {%- if section.settings.image_border_color != blank -%}
    #ImageWithTextMedia-{{ section.id }}.global-media-settings {
      border-color: {{ section.settings.image_border_color | color_modify: 'alpha', img_border_alpha }};
    }
  {%- endif -%}

  {%- comment -%}
    Same idea for the text box: .content-container reads the global
    --text-boxes-* variables, so overriding them scopes the styling here.
  {%- endcomment -%}
  #ImageWithText--{{ section.id }} {
    --text-boxes-radius: {{ section.settings.content_radius }}px;
    --text-boxes-border-width: {{ section.settings.content_border_thickness }}px;
    --text-boxes-border-opacity: {{ content_border_alpha }};
    --text-boxes-shadow-opacity: {{ section.settings.content_shadow_opacity | divided_by: 100.0 }};
    --text-boxes-shadow-blur-radius: {{ section.settings.content_shadow_blur }}px;
    --text-boxes-shadow-visible: {% if section.settings.content_shadow_opacity > 0 %}1{% else %}0{% endif %};
  }

  {%- if section.settings.content_border_color != blank -%}
    #ImageWithText--{{ section.id }}.content-container {
      border-color: {{ section.settings.content_border_color | color_modify: 'alpha', content_border_alpha }};
    }
  {%- endif -%}

  {%- if section.settings.content_background != blank -%}
    #ImageWithText--{{ section.id }}.content-container {
      background: {{ section.settings.content_background }};
    }
  {%- endif -%}

  {%- comment -%}
    global-media-settings forces `overflow: visible` so the shadow can escape,
    which means the container's radius does not clip the image — it is applied
    to the image itself instead.
  {%- endcomment -%}
  #ImageWithTextMedia-{{ section.id }} img,
  #ImageWithTextMedia-{{ section.id }} .placeholder-svg {
    object-position: {{ section.settings.image_focal_point }};
    border-radius: {{ section.settings.image_radius }}px;
  }

  {%- if section.settings.image_overlay_opacity > 0 -%}
    #ImageWithTextMedia-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      border-radius: {{ section.settings.image_radius }}px;
      background: {% if section.settings.image_overlay_color != blank %}{{ section.settings.image_overlay_color | color_modify: 'alpha', img_overlay_alpha }}{% else %}rgba(0, 0, 0, {{ img_overlay_alpha }}){% endif %};
    }
  {%- endif -%}

  {%- if section.settings.height == 'custom' -%}
    #ImageWithTextMedia-{{ section.id }} {
      height: {{ section.settings.image_custom_height | times: 0.7 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #ImageWithTextMedia-{{ section.id }} {
        height: {{ section.settings.image_custom_height }}px;
      }
    }
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            id="ImageWithTextMedia-{{ section.id }}"
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  {%- comment -%}
                    Only values the merchant changed are emitted, so the
                    'Heading size' select still drives whatever is untouched.
                  {%- endcomment -%}
                  {%- capture heading_style -%}
                    {%- if block.settings.heading_font_size > 0 %}font-size: {{ block.settings.heading_font_size }}px;{% endif -%}
                    {%- if block.settings.heading_line_height > 0 %}line-height: {{ block.settings.heading_line_height | divided_by: 100.0 }};{% endif -%}
                    {%- if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif -%}
                    {%- if block.settings.heading_weight != 'inherit' %}font-weight: {{ block.settings.heading_weight }};{% endif -%}
                    {%- if block.settings.heading_transform != 'inherit' %}text-transform: {{ block.settings.heading_transform }};{% endif -%}
                  {%- endcapture -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {%- if heading_style != blank %} style="{{ heading_style | strip_newlines | strip }}"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  {%- capture text_style -%}
                    {%- if block.settings.text_size > 0 %}font-size: {{ block.settings.text_size }}px;{% endif -%}
                    {%- if block.settings.text_line_height > 0 %}line-height: {{ block.settings.text_line_height | divided_by: 100.0 }};{% endif -%}
                    {%- if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif -%}
                    {%- if block.settings.text_weight != 'inherit' %}font-weight: {{ block.settings.text_weight }};{% endif -%}
                    {%- if block.settings.text_transform != 'inherit' %}text-transform: {{ block.settings.text_transform }};{% endif -%}
                  {%- endcapture -%}
                  <div
                    class="image-with-text__text rte {{ block.settings.text_style }}"
                    {%- if text_style != blank %} style="{{ text_style | strip_newlines | strip }}"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  <div
                    class="image-with-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} image-with-text__buttons--multiple{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.button_label != blank -%}
                      {%- capture btn1_style -%}
                        {%- render 'button-custom-style', settings: block.settings, prefix: 'btn1_' -%}
                      {%- endcapture -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}{% if block.settings.btn1_custom %} button--custom{% endif %}"
                        {%- if btn1_style != blank %} style="{{ btn1_style | strip_newlines | strip }}"{% endif %}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      {%- capture btn2_style -%}
                        {%- render 'button-custom-style', settings: block.settings, prefix: 'btn2_' -%}
                      {%- endcapture -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_2 }}"
                        {% endif %}
                        class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}{% if block.settings.btn2_custom %} button--custom{% endif %}"
                        {%- if btn2_style != blank %} style="{{ btn2_style | strip_newlines | strip }}"{% endif %}
                      >
                        {{ block.settings.button_label_2 | escape }}
                      </a>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:sections.image-with-text.settings.height.options__custom.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.image_style.content"
    },
    {
      "type": "range",
      "id": "image_custom_height",
      "min": 100,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_custom_height.label",
      "info": "t:sections.image-with-text.settings.image_custom_height.info",
      "default": 460
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "options": [
        {
          "value": "top left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_left.label"
        },
        {
          "value": "top center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_center.label"
        },
        {
          "value": "top right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__top_right.label"
        },
        {
          "value": "center left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_left.label"
        },
        {
          "value": "center center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_center.label"
        },
        {
          "value": "center right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__middle_right.label"
        },
        {
          "value": "bottom left",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_left.label"
        },
        {
          "value": "bottom center",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_center.label"
        },
        {
          "value": "bottom right",
          "label": "t:sections.image-with-text.settings.image_focal_point.options__bottom_right.label"
        }
      ],
      "default": "center center",
      "label": "t:sections.image-with-text.settings.image_focal_point.label",
      "info": "t:sections.image-with-text.settings.image_focal_point.info"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_radius.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_border_thickness.label",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "t:sections.image-with-text.settings.image_border_color.label",
      "info": "t:sections.image-banner.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "image_border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image_border_opacity.label",
      "default": 100
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "t:sections.image-with-text.settings.image_overlay_color.label",
      "info": "t:sections.image-with-text.settings.image_overlay_color.info"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image_shadow_opacity.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_shadow_blur",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_shadow_blur.label",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__2.label"
        }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "top",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.mobile_content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.content_style.content"
    },
    {
      "type": "range",
      "id": "content_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.content_radius.label",
      "default": 0
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "t:sections.image-with-text.settings.content_background.label",
      "info": "t:sections.image-with-text.settings.content_background.info"
    },
    {
      "type": "range",
      "id": "content_border_thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.image_border_thickness.label",
      "default": 0
    },
    {
      "type": "color",
      "id": "content_border_color",
      "label": "t:sections.image-with-text.settings.image_border_color.label",
      "info": "t:sections.image-banner.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "content_border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image_border_opacity.label",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image_shadow_opacity.label",
      "default": 0
    },
